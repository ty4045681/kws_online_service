+++ b/sherpa-onnx/csrc/transducer-keyword-decoder.cc
@@ -15,6 +15,62 @@
 #include "sherpa-onnx/csrc/onnx-utils.h"
 
 namespace sherpa_onnx {
+namespace {
+
+const ContextState *FindNearestKeywordEnd(const ContextState *state) {
+  if (!state || state->token == -1) return nullptr;
+  if (state->is_end) return state;
+
+  const ContextState *best = nullptr;
+  std::vector<const ContextState *> pending{state};
+  while (!pending.empty()) {
+    const ContextState *current = pending.back();
+    pending.pop_back();
+    if (current->is_end &&
+        (!best || current->level < best->level ||
+         (current->level == best->level && current->phrase < best->phrase))) {
+      best = current;
+    }
+    for (const auto &entry : current->next) {
+      pending.push_back(entry.second.get());
+    }
+  }
+  return best;
+}
+
+void UpdatePartialResult(const Hypothesis &best_hyp,
+                         TransducerKeywordResult *result) {
+  const auto &previous = result->partial;
+  TransducerPartialKeywordResult next;
+  const ContextState *state = best_hyp.context_state;
+  const ContextState *keyword_end = FindNearestKeywordEnd(state);
+
+  if (state && keyword_end && state->level > 0 &&
+      best_hyp.ys.size() >= static_cast<size_t>(state->level) &&
+      best_hyp.timestamps.size() >= static_cast<size_t>(state->level)) {
+    next.keyword = keyword_end->phrase;
+    next.tokens.assign(best_hyp.ys.end() - state->level, best_hyp.ys.end());
+    next.frame_indexes.assign(best_hyp.timestamps.end() - state->level,
+                              best_hyp.timestamps.end());
+    next.matched_token_count = state->level;
+    next.keyword_token_count = keyword_end->level;
+    next.is_active = true;
+  } else if (previous.is_active) {
+    next = previous;
+    next.is_active = false;
+  }
+
+  bool changed = next.keyword != previous.keyword ||
+                 next.tokens != previous.tokens ||
+                 next.frame_indexes != previous.frame_indexes ||
+                 next.matched_token_count != previous.matched_token_count ||
+                 next.keyword_token_count != previous.keyword_token_count ||
+                 next.is_active != previous.is_active;
+  next.revision = previous.revision + (changed ? 1 : 0);
+  result->partial = std::move(next);
+}
+
