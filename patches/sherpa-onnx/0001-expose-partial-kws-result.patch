+const SherpaOnnxPartialKeywordResult *SherpaOnnxGetPartialKeywordResult(
+    const SherpaOnnxKeywordSpotter *spotter,
+    const SherpaOnnxOnlineStream *stream) {
+  if (!spotter || !stream) return nullptr;
+  auto result = spotter->impl->GetPartialResult(stream->impl.get());
+  auto output = new SherpaOnnxPartialKeywordResult;
+  memset(output, 0, sizeof(SherpaOnnxPartialKeywordResult));
+
+  char *keyword = new char[result.keyword.size() + 1];
+  std::copy(result.keyword.begin(), result.keyword.end(), keyword);
+  keyword[result.keyword.size()] = 0;
+  output->keyword = keyword;
+  output->matched_token_count = result.matched_token_count;
+  output->keyword_token_count = result.keyword_token_count;
+  output->revision = result.revision;
+  output->is_active = result.is_active ? 1 : 0;
+
+  if (!result.tokens.empty()) {
+    size_t total_length = 0;
+    for (const auto &token : result.tokens) total_length += token.size() + 1;
+    char *token_storage = new char[total_length]{};
+    char **token_pointers = new char *[result.tokens.size()];
+    size_t offset = 0;
+    for (size_t i = 0; i < result.tokens.size(); ++i) {
+      token_pointers[i] = token_storage + offset;
+      memcpy(token_storage + offset, result.tokens[i].data(),
+             result.tokens[i].size());
+      offset += result.tokens[i].size() + 1;
+    }
+    output->tokens_arr = token_pointers;
+  }
+
+  if (!result.frame_indexes.empty()) {
+    auto frame_indexes = new int32_t[result.frame_indexes.size()];
+    std::copy(result.frame_indexes.begin(), result.frame_indexes.end(),
+              frame_indexes);
+    output->frame_indexes = frame_indexes;
+  }
+  return output;
+}
+
+void SherpaOnnxDestroyPartialKeywordResult(
+    const SherpaOnnxPartialKeywordResult *result) {
+  if (!result) return;
+  if (result->tokens_arr) {
+    delete[] result->tokens_arr[0];
+  }
+  delete[] result->tokens_arr;
+  delete[] result->frame_indexes;
+  delete[] result->keyword;
+  delete result;
+}
+
+const char *SherpaOnnxGetPartialKeywordResultAsJson(
+    const SherpaOnnxKeywordSpotter *spotter,
+    const SherpaOnnxOnlineStream *stream) {
+  if (!spotter || !stream) return nullptr;
+  std::string json =
+      spotter->impl->GetPartialResult(stream->impl.get()).AsJsonString();
+  char *output = new char[json.size() + 1];
+  std::copy(json.begin(), json.end(), output);
+  output[json.size()] = 0;
+  return output;
+}
